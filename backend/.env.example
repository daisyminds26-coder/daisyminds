# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=Daisy Minds LMS API

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins — includes the public website
# (website/, default dev port 5174) alongside the LMS frontend (5173), so
# the website's /apply flow can call the real auth API directly.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Proxy ---
# Number of hops to trust in front of this process (Nginx = 1). See DEPLOYMENT.md §4.
TRUST_PROXY=1

# --- Swagger ---
# Defaults to true outside production and false in production if left unset.
SWAGGER_ENABLED=true

# --- Authentication (Phase 2) ---
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this placeholder value outside local development.
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-please-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token

EMAIL_VERIFICATION_TOKEN_TTL_MIN=1440
PASSWORD_RESET_TOKEN_TTL_MIN=60

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15

# Lesson content upload limits (direct-to-Cloudinary; Express never proxies file bytes)
MAX_VIDEO_UPLOAD_MB=500
MAX_DOCUMENT_UPLOAD_MB=25
MAX_RESOURCE_UPLOAD_MB=25
MAX_RESOURCES_PER_LESSON=20

# --- Optional one-off bootstrap admin (scripts/seed-roles.ts only) ---
# Set both to create a SUPER_ADMIN on the next `npm run seed:roles` run.
# SEED_SUPER_ADMIN_EMAIL=admin@example.com
# SEED_SUPER_ADMIN_PASSWORD=change-me-please-1

# Base URL of the backend API, including the /api/v1 prefix (see API-STANDARDS.md).
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Display name used in page titles/branding. Public only — never a secret.
VITE_APP_NAME=Daisy Minds LMS

# Shown on the "account suspended" screen as a contact point. Optional —
# omit to hide the contact line entirely.
VITE_SUPPORT_EMAIL=support@daisyminds.example

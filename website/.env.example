# Base URL of the authenticated LMS application (frontend/). The public
# website never implements its own login — "Student Login" / "Admin Login"
# always hard-navigate here.
#
# Local dev default matches `frontend/`'s own dev server port.
VITE_LMS_URL=http://localhost:5173

# Canonical public URL of this site — used to build absolute canonical/OG
# URLs in the SEO layer. In production this becomes https://www.daisyminds.com.
VITE_SITE_URL=http://localhost:5174
